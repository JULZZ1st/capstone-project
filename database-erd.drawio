<mxfile host="app.diagrams.net" agent="Source-only Laravel migration ERD" version="24.7.17" type="device" pages="1">
  <diagram id="database-erd" name="Complete database ERD">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5300" pageHeight="4052" math="0" shadow="0" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="Tables and notes" parent="0" />
        <mxCell id="relations" value="Business foreign keys" parent="0" />
        <mxCell id="identity" value="Identity foreign keys" parent="0" />
        <mxCell id="tenancy" value="Workspace foreign keys" parent="0" />
        <mxCell id="title" value="DATABASE ENTITY RELATIONSHIP DIAGRAM" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Helvetica;fontSize=32;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="140" y="44" width="5020" height="46" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Laravel migration-defined MySQL schema | 73 migration files | 35 tables | 424 columns | 67 foreign keys | 22 unique constraints" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontSize=19;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="140" y="100" width="5020" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="PK = primary key    FK = declared foreign key    U1, U2 = unique constraint groups listed below each table    NN = NOT NULL    NULL = nullable    AI = AUTO_INCREMENT" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="140" y="148" width="5020" height="25" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="Connectors run from the FK column to the referenced column. Crow's foot = 0..many children; unique FK = 0..1 child. Parent end is 1 (NN) or 0..1 (NULL)." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="140" y="175" width="5020" height="25" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="Solid blue = business FK    Dashed amber = identity FK    Dotted teal = workspace FK. All 67 are visible; use the Layers panel to isolate a relationship category." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="140" y="202" width="5020" height="25" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="Scope: final forward-migration structure, read in filename order. Removed tables/columns are excluded. Hover over columns, tables and connectors for source definitions and constraint details." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="140" y="229" width="5020" height="25" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="Conditional legacy renames/imports depend on pre-existing tables with undefined schemas, so no legacy columns are inferred. Package-only tables and the framework migrations repository table are outside this folder." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="140" y="256" width="5020" height="25" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="Default values are in column tooltips; config(...) defaults remain symbolic because deployment environment values cannot be established from migration source. No migrations were executed and no database was connected." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="140" y="283" width="5020" height="25" as="geometry" />
        </mxCell>
