# Environment and secrets
.env
.env.*
!.env.example
/auth.json
/storage/*.key

# PHP and JavaScript dependencies
/vendor/
/node_modules/

# Laravel runtime storage
/storage/app/*
!/storage/app/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail/

# Laravel and framework cache
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/.phpunit.cache/
.phpunit.result.cache

# Frontend build output
/public/build/
/public/hot
/public/storage

# Local databases and generated data
*.sqlite
*.sqlite3
*.db
/database/*.sqlite
/database/*.sqlite3

# Logs and package manager diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs and editors
/.fleet/
/.idea/
/.nova/
/.vscode/
/.zed/
.phpactor.json

# OS and filesystem metadata
.DS_Store
Thumbs.db
desktop.ini

# Local development tooling
Homestead.json
Homestead.yaml
